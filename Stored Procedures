CREATE DEFINER=`root`@`localhost` PROCEDURE `CreateBooking`(IN `p_nutzerID` INT, IN `p_HausID` INT, IN `p_StartDatum` DATE, IN `p_EndDatum` DATE, IN `p_Preis` DECIMAL(10,2))
BEGIN
    -- Überprüfen, ob der Nutzer existiert
    IF NOT EXISTS (SELECT 1 FROM nutzer WHERE NutzerID = p_nutzerID) THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Nutzer existiert nicht.';
    END IF;

    -- Überprüfen, ob das Haus existiert
    IF NOT EXISTS (SELECT 1 FROM haus WHERE HausID = p_HausID) THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Haus existiert nicht.';
    END IF;

    -- Überprüfen, ob das Haus im angegebenen Zeitraum verfügbar ist
    IF EXISTS (
        SELECT 1
        FROM buchung
        WHERE HausID = p_HausID
          AND (
              (p_StartDatum BETWEEN StartDatum AND EndDatum)
              OR
              (p_EndDatum BETWEEN StartDatum AND EndDatum)
              OR
              (StartDatum BETWEEN p_StartDatum AND p_EndDatum)
          )
    ) THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Haus ist im angegebenen Zeitraum nicht verfügbar.';
    END IF;

    -- Einfügen der neuen Buchung
    INSERT INTO buchung (NutzerID, HausID, StartDatum, EndDatum, Preis)
    VALUES (p_nutzerID, p_HausID, p_StartDatum, p_EndDatum, p_Preis);
    
    
    UPDATE haus
    SET isFree = 0
    WHERE HausID = p_hausID;
END$$
DELIMITER ;

